{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "customer",
      "public": "dist/customer",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "kitchen",
      "public": "dist/kitchen",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "rider",
      "public": "dist/rider",
      "ignore": [
