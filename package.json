  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:customer": "VITE_APP_ROLE=customer vite build --outDir dist/customer",
    "build:kitchen": "VITE_APP_ROLE=kitchen vite build --outDir dist/kitchen",
